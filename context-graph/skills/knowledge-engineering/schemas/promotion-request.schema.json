{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "transaction_id", "project_id", "created_at", "event_refs", "canonical_refs", "memory_pointer", "expected_memory_sha256", "operations", "status"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "SessionPromotionRequest"},
    "transaction_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1},
    "event_refs": {"type": "array", "maxItems": 16}, "canonical_refs": {"type": "array", "maxItems": 16},
    "memory_pointer": {"type": "string", "minLength": 1}, "expected_memory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 2}, "status": {"const": "proposed"}
  }
}
