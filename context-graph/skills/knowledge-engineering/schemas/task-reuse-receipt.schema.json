{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "receipt_id", "project_id", "task_fingerprint", "evidence_fingerprint", "outcome", "receipt_status", "artifact_refs", "review_pointer", "review_sha256", "acceptance_contract", "rights_sha256", "policy_sha256", "created_at", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "TaskReuseReceipt"},
    "receipt_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1},
    "task_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["reuse", "skip", "refresh", "branch"]}, "receipt_status": {"const": "accepted_artifact"},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "locator"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "locator": {"type": "string", "minLength": 1}}}},
    "review_pointer": {"type": "string", "minLength": 1}, "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "policy_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "acceptance_contract": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}}},
    "created_at": {"type": "string", "minLength": 1}, "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
