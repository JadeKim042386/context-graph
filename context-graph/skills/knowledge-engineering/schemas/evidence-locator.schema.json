{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "locator"
  ],
  "additionalProperties": false,
  "properties": {
    "locator": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:line:[1-9][0-9]*(?:-[1-9][0-9]*)?|html:#[^\\s#]+|pdf:page=[1-9][0-9]*(?:;bbox=[0-9.,]+)?|table:sheet=[^;]{1,31};cell=[A-Z]{1,3}[1-9][0-9]{0,6}(?::[A-Z]{1,3}[1-9][0-9]{0,6})?|image:bbox=[0-9.,]+|av:t=[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?-[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?)$"
    },
    "quote": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8192
    }
  }
}
