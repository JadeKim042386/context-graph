{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "project_id", "question_key", "scope", "as_of", "acceptance_contract", "artifacts", "rights_sha256", "review_sha256", "policy_sha256", "allow_skip"],
  "properties": {
    "schema_version": {"const": 1}, "record_type": {"const": "TaskReuseRequest"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "question_key": {"type": "string", "minLength": 1, "maxLength": 160},
    "scope": {"type": "string", "minLength": 1, "maxLength": 160},
    "as_of": {"type": "string", "minLength": 1, "maxLength": 64},
    "acceptance_contract": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "locator"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "locator": {"type": "string", "minLength": 1}}}},
    "rights_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "review_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "policy_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "allow_skip": {"type": "boolean"}
  }
}
