{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-engineering/scripts/record_session_event.py\" --event session_start",
            "timeout": 10,
            "statusMessage": "Recording session state..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map..."
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map (delegated task ended)..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-engineering/scripts/record_session_event.py\" --event pre_compact",
            "timeout": 10,
            "statusMessage": "Recording session state before compaction..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-engineering/scripts/record_session_event.py\" --event post_compact",
            "timeout": 10,
            "statusMessage": "Recording session state after compaction..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map (after compaction)..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/knowledge-engineering/scripts/record_session_event.py\" --event session_end",
            "timeout": 10,
            "statusMessage": "Recording final session state..."
          }
        ]
      }
    ]
  }
}
