{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map..."
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map (delegated task ended)..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '[context-graph] The map is about to lose this session. Anything worth keeping has to be written into the knowledge documents first - the map only carries what the documents say.'",
            "timeout": 600,
            "statusMessage": "Reminder: write the session into the knowledge documents"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map (after compaction)..."
          }
        ]
      }
    ]
  }
}
