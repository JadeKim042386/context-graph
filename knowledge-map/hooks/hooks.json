{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\" --quiet",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map (delegated task ended)..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '[before compaction - writing the session into the knowledge documents]'",
            "timeout": 600,
            "statusMessage": "Writing the session into the knowledge documents..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/build_map.py\"",
            "timeout": 60,
            "statusMessage": "Refreshing the knowledge map (after compaction)..."
          }
        ]
      }
    ]
  }
}
